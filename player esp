-- ==========================================
-- 2. 果冻缩放拖拽逻辑 (适配 290 高度)
-- ==========================================
local isDragging = false
local dragStart, startPos
local activeTouch = nil

mainFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 
or (input.UserInputType == Enum.UserInputType.Touch and not activeTouch) then

           isDragging = true
dragStart = input.Position
startPos = mainFrame.Position

if input.UserInputType == Enum.UserInputType.Touch then
    activeTouch = input
end

        local baseWidth = 230
        local baseHeight = ESP_SETTINGS.Minimized and 50 or 290
        TweenService:Create(mainFrame, TweenInfo.new(0.4, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out), {
            Size = UDim2.new(0, baseWidth + 15, 0, baseHeight + 15),
            BackgroundTransparency = 0.35
        }):Play()

        input.Changed:Connect(function()
    if input.UserInputState == Enum.UserInputState.End then
        
        if input.UserInputType == Enum.UserInputType.Touch then
            if input == activeTouch then
                activeTouch = nil
                isDragging = false
            end
        else
            isDragging = false
        end
                local finalHeight = ESP_SETTINGS.Minimized and 50 or 290
                TweenService:Create(mainFrame, TweenInfo.new(0.5, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out), {
                    Size = UDim2.new(0, 230, 0, finalHeight),
                    BackgroundTransparency = 0.5
                }):Play()
            end
        end)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if not isDragging then return end

    if input.UserInputType == Enum.UserInputType.MouseMovement then
        local delta = input.Position - dragStart

        mainFrame.Position = UDim2.new(
            startPos.X.Scale,
            startPos.X.Offset + delta.X,
            startPos.Y.Scale,
            startPos.Y.Offset + delta.Y
        )

    elseif input.UserInputType == Enum.UserInputType.Touch and input == activeTouch then
        local delta = input.Position - dragStart

        mainFrame.Position = UDim2.new(
            startPos.X.Scale,
            startPos.X.Offset + delta.X,
            startPos.Y.Scale,
            startPos.Y.Offset + delta.Y
        )
    end
end)
       
miniBtn.MouseButton1Click:Connect(function()
    ESP_SETTINGS.Minimized = not ESP_SETTINGS.Minimized
    contentFrame.Visible = not ESP_SETTINGS.Minimized
    local targetSize = ESP_SETTINGS.Minimized and UDim2.new(0, 230, 0, 50) or UDim2.new(0, 230, 0, 290)
    TweenService:Create(mainFrame, TweenInfo.new(0.6, Enum.EasingStyle.Elastic), {Size = targetSize}):Play()
    miniBtn.Text = ESP_SETTINGS.Minimized and "+" or "−"
end)

-- ==========================================
-- 3. 渲染引擎 (强力队伍过滤核心逻辑)
-- ==========================================

local function ClearAllESP()
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj.Name == "Gemini_Highlight" or obj.Name == "Gemini_Info" or obj.Name == "Gemini_2DBox" then
            obj:Destroy()
        end
    end
end

-- 后台切回自动唤醒逻辑
UserInputService.WindowFocused:Connect(function()
    task.wait(0.5)
    ClearAllESP()
end)

local function updateESP()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= localPlayer and p.Character then
            local char = p.Character
            local hum = char:FindFirstChild("Humanoid")
            local head = char:FindFirstChild("Head")
            local root = char:FindFirstChild("HumanoidRootPart")
            
            if hum and root and head and hum.Health > -1000 then
                local isTeammate = (p.Team == localPlayer.Team)
                local teamColor = p.TeamColor.Color
                
                -- --- 队伍过滤：队友屏蔽除了高亮外的所有透视 ---
                local isFiltered = ESP_SETTINGS.TeamCheck and isTeammate

                -- A. 高亮 (队友保留，同步队伍颜色)
                local high = char:FindFirstChild("Gemini_Highlight")
                if ESP_SETTINGS.HighlightEnabled then
                    if not high then
                        high = Instance.new("Highlight", char)
                        high.Name = "Gemini_Highlight"
                    end
                    high.Enabled = true
                    high.FillColor = teamColor
                    high.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                elseif high then
                    high:Destroy()
                end

                -- B. 2D方框 (队友消失，透明度0纯描边)
                local boxGui = char:FindFirstChild("Gemini_2DBox")
                if ESP_SETTINGS.BoxEnabled and not isFiltered then
                    if not boxGui then
                        boxGui = Instance.new("BillboardGui", char)
                        boxGui.Name = "Gemini_2DBox"
                        boxGui.AlwaysOnTop = true
                        boxGui.Size = UDim2.new(4.5, 0, 6, 0) -- R15 比例
                        boxGui.Adornee = root
                        local f = Instance.new("Frame", boxGui)
                        f.Size = UDim2.new(1, 0, 1, 0)
                        f.BackgroundTransparency = 1
                        local s = Instance.new("UIStroke", f)
                        s.Thickness = 1.5
                        s.Transparency = 0
                    end
                    boxGui.Enabled = true
                    boxGui.Frame.UIStroke.Color = teamColor -- 描边变色
                elseif boxGui then
                    boxGui:Destroy()
                end

                -- C. 文字信息 (队友消失，富文本始终置顶)
                local infoGui = char:FindFirstChild("Gemini_Info")
                if (ESP_SETTINGS.ShowName or ESP_SETTINGS.ShowHealth or ESP_SETTINGS.ShowDist) and not isFiltered then
                    if not infoGui then
                        infoGui = Instance.new("BillboardGui", char)
                        infoGui.Name = "Gemini_Info"
                        infoGui.AlwaysOnTop = true
                        infoGui.Size = UDim2.new(0, 200, 0, 50)
                        infoGui.Adornee = head
                        infoGui.ExtentsOffset = Vector3.new(0, 3.5, 0)
                        local l = Instance.new("TextLabel", infoGui)
                        l.Name = "Label"
                        l.BackgroundTransparency = 1
                        l.TextColor3 = Color3.new(1, 1, 1)
                        l.TextStrokeTransparency = 0.5
                        l.RichText = true
                        l.Font = Enum.Font.GothamMedium
                        l.Size = UDim2.new(1, 0, 1, 0)
                    end
                    infoGui.Enabled = true
                    
                    local text = ""
                    if ESP_SETTINGS.ShowName then text = text .. "<b>" .. p.DisplayName .. "</b>\n" end
                    
                    local stats = ""
                    if ESP_SETTINGS.ShowHealth then 
                        local hp = math.floor(hum.Health)
                        local hpColor = (hp > 50 and "#55ff55" or "#ff5555")
                        stats = stats .. "<font color='" .. hpColor .. "'>HP: " .. hp .. "</font> " 
                    end
                    if ESP_SETTINGS.ShowDist then
                        -- 使用 Camera 位置计算距离，在 iOS 上更稳
                        local dist = math.floor((Camera.CFrame.Position - root.Position).Magnitude)
                        stats = stats .. (stats ~= "" and " | " or "") .. "<font color='#ffffff'>" .. dist .. "m</font>"
                    end
                    infoGui.Label.Text = text .. stats
                elseif infoGui then
                    infoGui:Destroy()
                end
            end
        end
    end
end

RunService.Heartbeat:Connect(updateESP)