createToggle("血量条目", "ShowHealth")

-- ==========================================
-- 2. 修复后的稳定拖拽逻辑 (带状态锁定的果冻缩放)
-- ==========================================
local isDragging = false
local dragStart, startPos

mainFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        isDragging = true
        dragStart = input.Position
        startPos = mainFrame.Position

        -- 根据当前状态决定放大比例
        local baseWidth = 230
        local baseHeight = ESP_SETTINGS.Minimized and 50 or 220
        
        TweenService:Create(mainFrame, TweenInfo.new(0.4, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out), {
            Size = UDim2.new(0, baseWidth + 15, 0, baseHeight + 15),
            BackgroundTransparency = 0.35
        }):Play()

        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                isDragging = false
                -- 核心修复：根据 Minimized 状态决定回弹尺寸
                local finalHeight = ESP_SETTINGS.Minimized and 50 or 220
                TweenService:Create(mainFrame, TweenInfo.new(0.5, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out), {
                    Size = UDim2.new(0, 230, 0, finalHeight),
                    BackgroundTransparency = 0.5
                }):Play()
            end
        end)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if isDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        mainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

miniBtn.MouseButton1Click:Connect(function()
    ESP_SETTINGS.Minimized = not ESP_SETTINGS.Minimized
    contentFrame.Visible = not ESP_SETTINGS.Minimized
    local targetSize = ESP_SETTINGS.Minimized and UDim2.new(0, 230, 0, 50) or UDim2.new(0, 230, 0, 220)
    TweenService:Create(mainFrame, TweenInfo.new(0.6, Enum.EasingStyle.Elastic), {Size = targetSize}):Play()
    miniBtn.Text = ESP_SETTINGS.Minimized and "+" or "−"
end)

-- ==========================================
-- 3. 渲染引擎 (保持原样)
-- ==========================================
local function updateESP()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= localPlayer then
            local char = p.Character
            if char and char:FindFirstChild("Humanoid") and char:FindFirstChild("Head") then
                local high = char:FindFirstChild("Gemini_Highlight") or Instance.new("Highlight", char)
                high.Name = "Gemini_Highlight"
                local bgui = char:FindFirstChild("Gemini_Info") or Instance.new("BillboardGui", char)
                bgui.Name = "Gemini_Info"
                local label = bgui:FindFirstChild("Label") or Instance.new("TextLabel", bgui)
                label.Name = "Label"

                if ESP_SETTINGS.Enabled then
                    high.Enabled = true
                    high.FillColor = p.TeamColor.Color
                    high.FillTransparency = 0.5
                    high.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                    bgui.AlwaysOnTop = true
                    bgui.Size = UDim2.new(0, 200, 0, 50)
                    bgui.Adornee = char.Head
                    bgui.ExtentsOffset = Vector3.new(0, 3, 0)
                    label.Size = UDim2.new(1, 0, 1, 0)
                    label.BackgroundTransparency = 1
                    label.TextColor3 = Color3.new(1, 1, 1)
                    label.TextStrokeTransparency = 0.5
                    label.RichText = true
                    label.Font = Enum.Font.GothamMedium

                    local text = ""
                    if ESP_SETTINGS.ShowName then text = text .. "<b>" .. p.DisplayName .. "</b>\n" end
                    if ESP_SETTINGS.ShowHealth then 
                        local hp = math.floor(char.Humanoid.Health)
                        local color = hp > 50 and "#55ff55" or "#ff5555"
                        text = text .. "<font color='" .. color .. "'>HP: " .. hp .. "</font> " 
                    end
                    if ESP_SETTINGS.ShowDist then
                        local dist = (localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart")) 
                            and math.floor((localPlayer.Character.HumanoidRootPart.Position - char.HumanoidRootPart.Position).Magnitude) or 0
                        text = text .. " | <font color='#ffffff'>" .. dist .. "m</font>"
                    end
                    label.Text = text
                    label.Visible = true
                else
                    high.Enabled = false
                    label.Visible = false
                end
            end
        end
    end
end

RunService.Heartbeat:Connect(updateESP)
