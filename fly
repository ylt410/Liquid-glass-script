-- ==========================================
-- 2. 物理拖拽 + 最小化逻辑
-- ==========================================
local isDragging = false
local dragStart, startPos
local isMinimized = false

Frame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        isDragging = true
        dragStart = input.Position
        startPos = Frame.Position
        local targetH = isMinimized and 45 or 160
        TweenService:Create(Frame, TweenInfo.new(0.4, Enum.EasingStyle.Elastic), {Size = UDim2.new(0, 200, 0, targetH + 10)}):Play()
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                isDragging = false
                local finalH = isMinimized and 45 or 160
                TweenService:Create(Frame, TweenInfo.new(0.5, Enum.EasingStyle.Elastic), {Size = UDim2.new(0, 190, 0, finalH)}):Play()
            end
        end)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if isDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        Frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

miniBtn.MouseButton1Click:Connect(function()
    isMinimized = not isMinimized
    content.Visible = not isMinimized
    authorText.Visible = not isMinimized
    local targetH = isMinimized and 45 or 160
    TweenService:Create(Frame, TweenInfo.new(0.6, Enum.EasingStyle.Elastic), {Size = UDim2.new(0, 190, 0, targetH)}):Play()
    miniBtn.Text = isMinimized and "+" or "−"
end)

