-- --- 按钮工厂 ---
local function createToggle(text, settingKey)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0.88, 0, 0, 36)
    btn.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    btn.BackgroundTransparency = 0.94
    btn.Text = "  " .. text
    btn.TextColor3 = Color3.fromRGB(220, 220, 220)
    btn.Font = Enum.Font.GothamMedium
    btn.TextSize = 13
    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.Parent = contentFrame
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 12)

    local indicator = Instance.new("Frame", btn)
    indicator.Size = UDim2.new(0, 32, 0, 18)
    indicator.Position = UDim2.new(1, -40, 0.5, -9)
    indicator.BackgroundColor3 = NPC_SETTINGS[settingKey] and Color3.fromRGB(0, 200, 255) or Color3.fromRGB(90, 90, 90)
    Instance.new("UICorner", indicator).CornerRadius = UDim.new(1, 0)
    
    local dot = Instance.new("Frame", indicator)
    dot.Size = UDim2.new(0, 14, 0, 14)
    dot.Position = NPC_SETTINGS[settingKey] and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7)
    dot.BackgroundColor3 = Color3.new(1, 1, 1)
    Instance.new("UICorner", dot).CornerRadius = UDim.new(1, 0)

    btn.MouseButton1Click:Connect(function()
        NPC_SETTINGS[settingKey] = not NPC_SETTINGS[settingKey]
        TweenService:Create(indicator, TweenInfo.new(0.3), {BackgroundColor3 = NPC_SETTINGS[settingKey] and Color3.fromRGB(0, 200, 255) or Color3.fromRGB(90, 90, 90)}):Play()
        dot:TweenPosition(NPC_SETTINGS[settingKey] and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7), "Out", "Back", 0.3, true)
    end)
    return btn
end

createToggle("启动感应", "Enabled")
createToggle("识别代号", "ShowName")
createToggle("距离测绘", "ShowDist")

-- ==========================================
-- 2. 稳定拖拽 + 果冻缩放 (完全同步你最爱的那版)
-- ==========================================
local isDragging = false
local dragStart, startPos

mainFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        isDragging = true
        dragStart = input.Position
        startPos = mainFrame.Position

        local baseHeight = NPC_SETTINGS.Minimized and 50 or 180
        TweenService:Create(mainFrame, TweenInfo.new(0.4, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out), {
            Size = UDim2.new(0, 245, 0, baseHeight + 15),
            BackgroundTransparency = 0.35
        }):Play()

        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                isDragging = false
                local finalHeight = NPC_SETTINGS.Minimized and 50 or 180
                TweenService:Create(mainFrame, TweenInfo.new(0.5, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out), {
                    Size = UDim2.new(0, 230, 0, finalHeight),
                    BackgroundTransparency = 0.5
                }):Play()
            end
        end)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if isDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        mainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

miniBtn.MouseButton1Click:Connect(function()
    NPC_SETTINGS.Minimized = not NPC_SETTINGS.Minimized
    contentFrame.Visible = not NPC_SETTINGS.Minimized
    local targetSize = NPC_SETTINGS.Minimized and UDim2.new(0, 230, 0, 50) or UDim2.new(0, 230, 0, 180)
    TweenService:Create(mainFrame, TweenInfo.new(0.6, Enum.EasingStyle.Elastic), {Size = targetSize}):Play()
    miniBtn.Text = NPC_SETTINGS.Minimized and "+" or "−"
end)

-- ==========================================
-- 3. NPC 扫描与渲染引擎
-- ==========================================
local function isNPC(model)
    if model:IsA("Model") and model:FindFirstChild("Humanoid") and model:FindFirstChild("Head") then
        -- 核心逻辑：如果模型不是玩家的 Character，则是 NPC
        if not Players:GetPlayerFromCharacter(model) then
            return true
        end
    end
    return false
end

local function updateNPC_ESP()
    for _, obj in ipairs(workspace:GetDescendants()) do
        if isNPC(obj) then
            local head = obj.Head
            local hum = obj.Humanoid
            
            -- 创建或获取渲染组件
            local high = obj:FindFirstChild("NPC_Highlight") or Instance.new("Highlight", obj)
            high.Name = "NPC_Highlight"
            
            local bgui = obj:FindFirstChild("NPC_Info") or Instance.new("BillboardGui", obj)
            bgui.Name = "NPC_Info"
            
            local label = bgui:FindFirstChild("Label") or Instance.new("TextLabel", bgui)
            label.Name = "Label"

            if NPC_SETTINGS.Enabled then
                high.Enabled = true
                high.FillColor = Color3.fromRGB(0, 255, 255) -- 青色玻璃感
                high.FillTransparency = 0.6
                high.OutlineColor = Color3.new(1, 1, 1)

                bgui.AlwaysOnTop = true
                bgui.Size = UDim2.new(0, 200, 0, 50)
                bgui.Adornee = head
                bgui.ExtentsOffset = Vector3.new(0, 2.5, 0)

                label.Size = UDim2.new(1, 0, 1, 0)
                label.BackgroundTransparency = 1
                label.TextColor3 = Color3.fromRGB(0, 255, 255)
                label.TextStrokeTransparency = 0.5
                label.RichText = true
                label.Font = Enum.Font.GothamMedium
                label.TextSize = 14

                local text = ""
                if NPC_SETTINGS.ShowName then text = text .. "<b>[NPC] " .. obj.Name .. "</b>\n" end
                if NPC_SETTINGS.ShowDist then
                    local hrp = obj:FindFirstChild("HumanoidRootPart")
                    local myHrp = localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart")
                    if hrp and myHrp then
                        local dist = math.floor((hrp.Position - myHrp.Position).Magnitude)
                        text = text .. "<font color='#ffffff'>" .. dist .. "m</font>"
                    end
                end
                
                label.Text = text
                label.Visible = true
            else
                high.Enabled = false
                label.Visible = false
            end
        end
    end
end

-- 为了性能，NPC 扫描可以稍慢一点点
task.spawn(function()
    while task.wait(0.5) do
        updateNPC_ESP()
    end
end)
