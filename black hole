-- 2. 交互逻辑 (最小化 + 果冻拖拽)
-- ==========================================

-- 最小化功能
miniBtn.MouseButton1Click:Connect(function()
    SETTINGS.IsMinimized = not SETTINGS.IsMinimized
    local targetHeight = SETTINGS.IsMinimized and SETTINGS.MinHeight or SETTINGS.MaxHeight
    miniBtn.Text = SETTINGS.IsMinimized and "+" or "−"
    
    TweenService:Create(mainFrame, TweenInfo.new(0.5, Enum.EasingStyle.Elastic), {
        Size = UDim2.new(0, SETTINGS.Width, 0, targetHeight)
    }):Play()
    container.Visible = not SETTINGS.IsMinimized
end)

-- 果冻拖拽 (确保无限次生效)
local dragging = false
local dragStart, startPos
mainFrame.InputBegan:Connect(function(input)
    if (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
        dragging = true
        dragStart = input.Position
        startPos = mainFrame.Position
        
        local currentHeight = SETTINGS.IsMinimized and SETTINGS.MinHeight or SETTINGS.MaxHeight
        TweenService:Create(mainFrame, TweenInfo.new(0.4, Enum.EasingStyle.Elastic), {
            Size = UDim2.new(0, SETTINGS.Width + 15, 0, currentHeight + 10)
        }):Play()
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        mainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
        local targetHeight = SETTINGS.IsMinimized and SETTINGS.MinHeight or SETTINGS.MaxHeight
        TweenService:Create(mainFrame, TweenInfo.new(0.5, Enum.EasingStyle.Elastic), {
            Size = UDim2.new(0, SETTINGS.Width, 0, targetHeight)
        }):Play()
    end
end)

