-- 3. 黑洞控制逻辑
-- ==========================================
toggleBtn.MouseButton1Click:Connect(function()
    SETTINGS.Enabled = not SETTINGS.Enabled
    toggleBtn.Text = SETTINGS.Enabled and "黑洞: 开启" or "黑洞: 关闭"
    TweenService:Create(toggleBtn, TweenInfo.new(0.3), {
        BackgroundColor3 = SETTINGS.Enabled and Color3.fromRGB(50, 210, 110) or Color3.fromRGB(255, 50, 50)
    }):Play()
end)

decBtn.MouseButton1Click:Connect(function()
    SETTINGS.Radius = math.max(0, SETTINGS.Radius - 5)
    radiusDisp.Text = "半径: " .. SETTINGS.Radius
end)

incBtn.MouseButton1Click:Connect(function()
    SETTINGS.Radius = math.min(500, SETTINGS.Radius + 5)
    radiusDisp.Text = "半径: " .. SETTINGS.Radius
end)

-- 零件环绕物理引擎
local parts = {}
local function addPart(p)
    if p:IsA("BasePart") and not p.Anchored and not p:IsDescendantOf(LocalPlayer.Character) then
        p.CanCollide = false
        table.insert(parts, p)
    end
end
workspace.DescendantAdded:Connect(addPart)
for _,v in pairs(workspace:GetDescendants()) do addPart(v) end

RunService.Heartbeat:Connect(function()
    if not SETTINGS.Enabled then return end
    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if hrp then
        for i, part in pairs(parts) do
            if part.Parent and not part.Anchored then
                local pos = part.Position
                local dist = (Vector3.new(pos.X, hrp.Position.Y, pos.Z) - hrp.Position).Magnitude
                local angle = math.atan2(pos.Z - hrp.Position.Z, pos.X - hrp.Position.X) + math.rad(SETTINGS.RotationSpeed)
                local target = Vector3.new(
                    hrp.Position.X + math.cos(angle) * math.min(SETTINGS.Radius, dist),
                    hrp.Position.Y + (SETTINGS.Height * math.abs(math.sin((pos.Y - hrp.Position.Y)/SETTINGS.Height))),
                    hrp.Position.Z + math.sin(angle) * math.min(SETTINGS.Radius, dist)
                )
                part.Velocity = (target - part.Position).unit * SETTINGS.AttractionStrength
            else
                table.remove(parts, i)
            end
        end
    end
end)
