    TweenService:Create(mainFrame, TweenInfo.new(0.6, Enum.EasingStyle.Elastic), {Size = targetSize}):Play()
    miniBtn.Text = OBJ_SETTINGS.Minimized and "+" or "−"
end)

-- ==========================================
-- 3. 绘制逻辑 (精准绑定渲染)
-- ==========================================
local function addESP(obj)
    local adornee = obj:IsA("BasePart") and obj or obj:FindFirstChildWhichIsA("BasePart")
    if not adornee or obj:FindFirstChild("Gemini_ESP") then return end

    local high = Instance.new("Highlight", obj)
    high.Name = "Gemini_High"
    high.FillColor = Color3.fromRGB(255, 180, 0)
    high.FillTransparency = 0.6

    local bgui = Instance.new("BillboardGui", obj)
    bgui.Name = "Gemini_ESP"
    bgui.Adornee = adornee
    bgui.AlwaysOnTop = true
    bgui.Size = UDim2.new(0, 150, 0, 40)
    bgui.ExtentsOffset = Vector3.new(0, 2, 0)

    local label = Instance.new("TextLabel", bgui)
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.TextColor3 = Color3.fromRGB(255, 200, 50)
    label.Font = Enum.Font.GothamBold
    label.TextSize = 13
    label.RichText = true

    RunService.RenderStepped:Connect(function()
        if not obj or not obj.Parent then return end
        if OBJ_SETTINGS.Enabled then
            high.Enabled = true
            bgui.Enabled = true
            local text = ""
            if OBJ_SETTINGS.ShowName then text = text .. "✨ " .. obj.Name .. "\n" end
            if OBJ_SETTINGS.ShowDist and localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart") then
                local dist = math.floor((adornee.Position - localPlayer.Character.HumanoidRootPart.Position).Magnitude)
                text = text .. "<font size='10' color='#ffffff'>" .. dist .. "m</font>"
            end
            label.Text = text
        else
            high.Enabled = false
            bgui.Enabled = false
        end
    end)
end

-- 扫描交互物
local function scan()
    for _, v in ipairs(workspace:GetDescendants()) do
        if v:IsA("ClickDetector") or v:IsA("ProximityPrompt") then
            addESP(v.Parent)
        end
    end
end

